<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.SafeAreaAbsoluteLayoutPage"
             x:DataType="local:SafeAreaViewModel"
             AutomationId="SafeAreaAbsoluteLayoutPage"
             SafeAreaEdges="None">

    <!-- ContentPage is intentionally edge-to-edge (SafeAreaEdges=None).
         The AbsoluteLayout below owns safe-area handling via its SafeAreaEdges binding. -->
    <AbsoluteLayout SafeAreaEdges="{Binding EffectiveSafeAreaEdges}"
                    Padding="{Binding Padding}"
                    Background="{Binding Background}">

        <!-- Main Content - ScrollView fills the entire AbsoluteLayout (LayoutFlags="All") -->
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout
                Spacing="10"
                Padding="65,80,65,80">
                <HorizontalStackLayout>
                    <Label Text="SafeAreaEdges: "
                           FontAttributes="Bold"/>

                    <Label AutomationId="SafeAreaEdgesValueLabel"
                           Text="{Binding DisplayString}"
                           FontSize="14"/>
                </HorizontalStackLayout>

                <Label x:Name="SafeAreaInsetsLabel"
                       AutomationId="SafeAreaInsetsLabel"
                       Text="Insets: Loading..."
                       FontSize="12"/>

                <Button AutomationId="Options"
                        Text="Options"
                        Clicked="NavigateToOptionsPage_Clicked"
                        HorizontalOptions="Start"/>

                <!-- SafeArea value buttons -->
                <HorizontalStackLayout Spacing="5">
                    <Button AutomationId="SafeAreaNoneButton"
                            Text="None"
                            FontSize="12"
                            Clicked="OnSafeAreaNoneClicked"/>
                    <Button AutomationId="SafeAreaAllButton"
                            Text="All"
                            FontSize="12"
                            Clicked="OnSafeAreaAllClicked"/>
                    <Button AutomationId="SafeAreaContainerButton"
                            Text="Container"
                            FontSize="12"
                            Clicked="OnSafeAreaContainerClicked"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="5">
                    <Button AutomationId="SafeAreaSoftInputButton"
                            Text="SoftInput"
                            FontSize="12"
                            Clicked="OnSafeAreaSoftInputClicked"/>
                    <Button AutomationId="SafeAreaDefaultButton"
                            Text="Default"
                            FontSize="12"
                            Clicked="OnSafeAreaDefaultClicked"/>
                </HorizontalStackLayout>

                <Label Text="Content below is for testing keyboard interaction:"
                       FontSize="12"
                       TextColor="Gray"/>

                <Entry x:Name="SafeAreaTestEntry"
                       AutomationId="SafeAreaTestEntry"
                       Placeholder="Tap to raise keyboard"
                       HorizontalOptions="Start"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Left Edge Indicator: anchored at left, full height.
             Declared before the top/bottom labels so those overpaint the overlap. -->
        <Label x:Name="LeftEdgeIndicator"
               AutomationId="LeftEdgeIndicator"
               Text="L"
               BackgroundColor="Green"
               TextColor="White"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               AbsoluteLayout.LayoutBounds="0,0,55,1"
               AbsoluteLayout.LayoutFlags="HeightProportional"/>

        <!-- Right Edge Indicator: anchored at right, full height. -->
        <Label x:Name="RightEdgeIndicator"
               AutomationId="RightEdgeIndicator"
               Text="R"
               BackgroundColor="Orange"
               TextColor="White"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               AbsoluteLayout.LayoutBounds="1,0,55,1"
               AbsoluteLayout.LayoutFlags="XProportional,HeightProportional"/>

        <!-- Top Edge Indicator: anchored at top, full width.
             LayoutFlags="WidthProportional" makes width = layoutWidth * 1.
             y=0 places the label at the top. -->
        <Label x:Name="TopEdgeIndicator"
               AutomationId="TopEdgeIndicator"
               Text="TOP TEST AREA: This should move in/out of notch/status bar area when safe area is toggled"
               BackgroundColor="Red"
               TextColor="Black"
               FontSize="14"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Padding="10"
               AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
               AbsoluteLayout.LayoutFlags="WidthProportional"/>

        <!-- Bottom Edge Indicator: anchored at bottom, full width.
             y=1 with YProportional anchors bottom edge to layout's bottom edge. -->
        <Label x:Name="BottomEdgeIndicator"
               AutomationId="BottomEdgeIndicator"
               Text="BOTTOM TEST AREA: This should move in/out of home indicator/toolbar area when safe area is toggled"
               BackgroundColor="Red"
               TextColor="Black"
               FontSize="14"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Padding="10"
               AbsoluteLayout.LayoutBounds="0,1,1,AutoSize"
               AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"/>
    </AbsoluteLayout>
</ContentPage>
